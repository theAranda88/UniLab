# PostgreSQL (servicio db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unilab
# Puerto en el host (mapeo docker-compose). Dentro del contenedor PostgreSQL sigue en 5432.
POSTGRES_PORT=5433

# Backend (servicio api)
JWT_SECRET=cambiar-este-secreto-en-produccion
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
# Mismo Client ID que google.config.ts; en Google Cloud añadir http://localhost:8080 (y 4200 si ng serve) a orígenes JS.
GOOGLE_CLIENT_ID=
UNIVERSITY_EMAIL_DOMAIN=uniautonoma.edu.co

# Frontend (servicio front)
FRONT_PORT=8080
